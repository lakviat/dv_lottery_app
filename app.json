{
  "expo": {
    "name": "DV Lottery Tracker",
    "slug": "dv-lottery-app",
    "version": "0.1.0",
    "platforms": [
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/branding/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dvlottery.expo",
      "appleTeamId": "ZDK3K9BT5S",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to prepare your DV entry.",
          "cameraPermission": "Take a photo to prepare your DV entry.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F6FA",
          "image": "./assets/branding/mark.png",
          "imageWidth": 112,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
